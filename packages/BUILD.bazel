load("@rules_rust//rust:defs.bzl", "rust_binary")
load(":package.bzl", "package_test")

package(default_visibility = ["//visibility:public"])

exports_files(["source.py"])

rust_binary(
    name = "check-blobs",
    srcs = ["check_blobs.rs"],
    edition = "2024",
    deps = [
        "@ppk_crates//:anyhow",
        "@ppk_crates//:sha2",
        "@ppk_crates//:zstd",
    ],
)

filegroup(
    name = "sources",
    srcs = glob([
        "*.py",
        "*.rs",
        "*.bzl",
    ]) + ["BUILD.bazel"],
)

package_test(
    name = "source-test",
    srcs = ["source.py"],
    main = "test_source.py",
)
