#!/bin/sh
# Validate maintained sources, native Bazel targets, and canonical packages.
set -eu
repo=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo"
python3 tools/style-check.py
./bazel test //...
./bazel build //:packages //:api-docs
cargo +1.98.1 clippy --locked --all-targets -- -D warnings
