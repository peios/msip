load("@crates//:crates.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")
load("//packages:package.bzl", "source_package")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

rust_library(
    name = "msip",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit-test",
    crate = ":msip",
)

[
    rust_test(
        name = name + "-test",
        srcs = ["tests/" + name + ".rs"],
        aliases = aliases(),
        edition = "2024",
        proc_macro_deps = all_crate_deps(proc_macro = True),
        deps = [":msip"] + all_crate_deps(normal = True),
    )
    for name in [
        "conversation",
        "loopback",
        "validation",
        "state",
        "framing",
    ]
]

rust_doc(
    name = "api-docs",
    crate = ":msip",
    rustdoc_flags = ["-Dwarnings"],
)

rust_doc_test(
    name = "doc-test",
    crate = ":msip",
)

filegroup(
    name = "sources",
    srcs = glob(
        [
            "*.toml",
            "*.lock",
            "*.md",
            ".bazel*",
            ".gitignore",
            ".github/**",
            "BUILD.bazel",
            "MODULE.bazel*",
            "bazel",
            "src/**",
            "tests/**",
            "docs/**",
            "tools/**",
            "LICENSE",
        ],
        allow_empty = True,
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "docs/learn/dist/**",
        ],
    ) + [
        "//build:sources",
        "//packages:sources",
        "//third_party/ppk:sources",
    ],
)

source_package(
    name = "packages",
    srcs = [":sources"],
    version = "0.1.1-1",
)
