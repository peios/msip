package(default_visibility = ["//visibility:public"])

exports_files(["rules-rust-system-libraries.patch"])

constraint_setting(
    name = "libc",
    default_constraint_value = ":libc-gnu",
)

constraint_value(
    name = "libc-gnu",
    constraint_setting = ":libc",
)

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)
